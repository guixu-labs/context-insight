{
  "openapi": "3.1.0",
  "info": {
    "title": "AgentLineage Learning API",
    "version": "0.1.0-draft",
    "description": "2026-10-08 未实施设计。调查、制卡和经验归并可产生模型费用；经验发布有独立权限。机械有效与语义审查分开。Core 地址由服务配置固定，不接受请求中的任意远程 Core URL。"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8111",
      "description": "建议本地独立服务端口，可配置"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/capabilities": {
      "get": {
        "operationId": "getLearningCapabilities",
        "summary": "组件、模型适配、经验格式与兼容范围",
        "x-required-scopes": [
          "memory:read"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            }
          },
          "default": {
            "description": "400/401/403/404/409/413/422/429/503 structured error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/investigations": {
      "post": {
        "operationId": "createInvestigation",
