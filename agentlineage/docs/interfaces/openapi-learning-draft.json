  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "令牌主体具有租户/项目授权；每项操作的 x-required-scopes 由服务端执行。"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "retryable",
          "request_id"
        ],
        "additionalProperties": false
      },
      "Gap": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "additionalProperties": false
      },
      "Capabilities": {
        "type": "object",
        "properties": {
          "component": {
            "type": "string"
          },
          "package_version": {
            "type": "string"
          },
          "api_version": {
            "type": "string"
          },
          "schema_versions": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "adapters": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                },
                "features": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "name",
                "version",
                "features"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "component",
          "package_version",
          "api_version",
          "schema_versions",
          "features",
          "adapters"
        ],
        "additionalProperties": false
      },
      "EvidenceRef": {
        "type": "object",
        "properties": {
          "snapshot_id": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "record_id": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "json_pointer": {
            "type": "string"
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "snapshot_id",
          "source_id",
          "content_sha256"
        ],
        "additionalProperties": false
      },
      "Budget": {
        "type": "object",
        "properties": {
          "max_model_calls": {
            "type": "integer",
            "minimum": 1
          },
          "max_input_tokens": {
            "type": "integer",
            "minimum": 1
          },
          "max_output_tokens": {
            "type": "integer",
            "minimum": 1
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "max_model_calls",
          "max_input_tokens",
          "max_output_tokens",
          "timeout_seconds"
        ],
        "additionalProperties": false
      },
      "Page": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "items",
          "next_cursor"
        ],
        "additionalProperties": false
      },
      "CreateInvestigation": {
        "type": "object",
        "properties": {
          "snapshot_id": {
            "type": "string"
