    "/v1/memory/proposals/{proposal_id}/publish": {
      "post": {
        "operationId": "publishMemoryProposal",
        "summary": "预期版本 CAS 发布；未满足审核策略返回 409/422",
        "x-required-scopes": [
          "memory:publish"
        ],
        "parameters": [
          {
            "name": "proposal_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "同一主体/路由下重复 key 与相同请求返回原结果；不同请求返回 409。保留期至少 7 天且覆盖作业终态后 7 天。",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Accepted; poll this resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Proposal"
                }
              }
            }
          },
          "default": {
            "description": "400/401/403/404/409/413/422/429/503 structured error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublishInput"
              }
            }
          }
        },
        "description": "发布许可不代替语义审查。approval_ref 如需则引用经授权的外部或本服务既有审核凭据；具体团队审批系统属于适配层。CAS 冲突保留草稿，不能自动覆盖。"
      }
    },
