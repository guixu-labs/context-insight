    "/v1/cases/{case_id}/reviews": {
      "post": {
        "operationId": "reviewCase",
        "summary": "提交独立语义评审；身份由服务认证确定",
        "x-required-scopes": [
          "case:review"
        ],
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "同一主体/路由下重复 key 与相同请求返回原结果；不同请求返回 409。保留期至少 7 天且覆盖作业终态后 7 天。",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaseReview"
                }
              }
            }
          },
          "default": {
            "description": "400/401/403/404/409/413/422/429/503 structured error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewInput"
              }
            }
          }
        },
        "description": "审核绑定具体 case_revision，不覆盖机械检查。独立模型必须与该案例生成者分开记账，并保存评审配置与证据；聚合冲突审查状态的规则在实现前冻结。"
      }
    },
    "/v1/memory/proposals": {
