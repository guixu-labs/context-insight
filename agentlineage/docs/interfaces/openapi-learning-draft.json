            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "同一主体/路由下重复 key 与相同请求返回原结果；不同请求返回 409。保留期至少 7 天且覆盖作业终态后 7 天。",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Accepted; poll this resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Investigation"
                }
              }
            }
          },
          "default": {
            "description": "400/401/403/404/409/413/422/429/503 structured error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateInvestigation"
              }
            }
          }
        }
      }
    },
